{
  "name": "browsee",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "nub@0.9.5",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.5",
      "onFail": "ignore"
    }
  },
  "bin": {
    "browsee": "bin/browsee.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "nub exec tsc -p tsconfig.build.json",
    "start": "bash run.sh",
    "e2e": "node e2e-test.mjs"
  },
  "devDependencies": {
    "@nubjs/types": ">=0.4.13 <=0.9.5",
    "@types/node": "^26",
    "typescript": "^7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  }
}
